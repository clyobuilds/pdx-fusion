# Copy to `.env` ON THE SERVER and fill in. Never share this file.
# The address of the site, without https:// (a test domain for now; see DEPLOY.md)
DOMAIN=qa.example.org
BASEURL=https://qa.example.org

# noindex = search engines are told to stay away (testing). Change to `index` ONLY at the hard launch.
INDEXING=noindex

HOST=0.0.0.0
PORT=13120
LOG_LEVEL=info
LOG_PATH=/app/data/logs
DB_DIALECT=sqlite
DB_STORAGE=/app/data/gancio.sqlite
DB_LOGGING=false
UPLOAD_PATH=/app/data/uploads
USER_LOCALE=/app/data/user_locale

# make a fresh one on the server with:  openssl rand -base64 32
NUXT_SESSION_PASSWORD=PASTE_A_NEW_SECRET_HERE

# makes `docker-compose` use the production file by default on the server
COMPOSE_FILE=docker-compose.prod.yml
